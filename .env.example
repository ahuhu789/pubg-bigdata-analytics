# Cassandra Configuration
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=pubg_analytics
CASSANDRA_USER=
CASSANDRA_PASSWORD=

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
JAVA_HOME=C:\Program Files\Microsoft\jdk-17.0.20.101-hotspot

# Pipeline Execution Mode: quick | full
PIPELINE_MODE=quick
ANOMALY_THRESHOLD_PERCENTILE=99.5
KMEANS_CLUSTERS=4
